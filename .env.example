# Base URL of the deployed Worker API, used by the frontend build in production.
# Leave empty for local development: vite.config.ts proxies /api to the local Worker.
VITE_API_BASE_URL=

# Read by `npm run stats` only (scripts/stats.ts), never by the app: the
# Cloudflare account's id, and an API token with the
# Account > Account Analytics > Read permission. Keep them in .env (gitignored).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
