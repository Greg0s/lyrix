{
  "name": "lyrix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --config worker/wrangler.toml --var SIMILARITY_SAMPLE:1",
    "dev:all": "concurrently -k -s first -n web,api \"npm:dev\" \"npm:dev:worker\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run lint && npm run typecheck && vitest run",
    "test:e2e": "playwright test",
    "deploy": "vite build && wrangler pages deploy dist",
    "deploy:worker": "wrangler deploy --config worker/wrangler.toml",
    "similarity:convert": "tsx scripts/convert-embeddings.ts",
    "similarity:build": "tsx scripts/build-similarity-table.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "description": "Pedantix-style lyrics guessing game.",
  "dependencies": {
    "hono": "^4.13.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.86.0"
  }
}
