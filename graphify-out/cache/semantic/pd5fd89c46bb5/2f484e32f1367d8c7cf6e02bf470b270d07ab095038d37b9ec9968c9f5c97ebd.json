{"nodes": [{"id": "docs_superpowers_specs_2026_10_19_song_hints_design_song_hints_design", "label": "Song Hints Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-10-19-song-hints-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stuck players give up rather than guess on; hints must help while staying a choice for players who want to find the song unaided."}, {"id": "docs_superpowers_specs_2026_10_19_song_hints_design_three_hints", "label": "Three Hints: Epoque, Type d'artiste, Style", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-19-song-hints-design.md", "source_location": "## Decisions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comparable in strength, so which one to take depends on what the lyrics already told the player."}, {"id": "docs_superpowers_specs_2026_10_19_song_hints_design_hint_thresholds", "label": "HINT_THRESHOLDS (20, 35, 50 guesses)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-19-song-hints-design.md", "source_location": "## Decisions", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_19_song_hints_design_unlocking_never_reveals", "label": "Unlocking Never Reveals", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-19-song-hints-design.md", "source_location": "## Decisions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A hint is shown only on the player's click, or once the round is won, so a player can still find the song unaided."}, {"id": "docs_superpowers_specs_2026_10_19_song_hints_design_worker_gated_hints", "label": "Worker-gated Hint Values", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-19-song-hints-design.md", "source_location": "## Decisions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hint values never enter the client bundle and cross the wire only once revealed or won, like revealHint."}, {"id": "docs_superpowers_specs_2026_10_19_song_hints_design_songfacts", "label": "SongFacts (songFacts.ts)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-19-song-hints-design.md", "source_location": "## 1. Song facts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hand-curated per catalog id; no hint value may share a word with the song's title or artist."}, {"id": "docs_superpowers_specs_2026_10_19_song_hints_design_hintvalues", "label": "hintValues", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-19-song-hints-design.md", "source_location": "## 1. Song facts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Artiste' rather than 'chanteur' says solo and gender without calling a rapper a singer."}, {"id": "docs_superpowers_specs_2026_10_19_song_hints_design_shared_hint_rules", "label": "Shared Hint Rules (src/game/hints.ts)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-19-song-hints-design.md", "source_location": "## 2. Shared rules", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_19_song_hints_design_sealed_tried_hints", "label": "Sealed tried and hints in StatePayload", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-19-song-hints-design.md", "source_location": "## 3. Sealed state", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sealing guess count and revealed hints makes them unforgeable; legacy states read tried as their found-word count; merges take max tried and union of hints."}, {"id": "docs_superpowers_specs_2026_10_19_song_hints_design_roundhints", "label": "RoundHints", "file_ty