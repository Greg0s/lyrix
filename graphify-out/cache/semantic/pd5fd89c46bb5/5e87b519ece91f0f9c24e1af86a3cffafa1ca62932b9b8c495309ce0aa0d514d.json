{"nodes": [{"id": "claude_lyrix_project", "label": "Lyrix (project)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Project Overview", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Pedantix-like daily game on song lyrics for French-speaking, tech-savvy players; one song per day for everyone, rotating at UTC midnight."}, {"id": "claude_daily_song_rotation", "label": "Daily Song Rotation (UTC midnight)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Project Overview", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Motus/Wordle-style shared puzzle; no replay with another song, only missed days via the archives, never a day to come."}, {"id": "claude_mvp_phase", "label": "MVP Phase (no 3D)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Current Phase: MVP", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "3D (three, @react-three/fiber, drei) is a planned post-MVP phase; only short CSS animations, disabled under prefers-reduced-motion."}, {"id": "claude_lyrix_v3_mockup", "label": "Lyrix v3 Mockup", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Current Phase: MVP", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_lrclib", "label": "LRCLIB (lrclib.net)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Tech Stack", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Queried via /api/search, not /api/get; asked about a song once ever, results kept in SONGS KV and the Cache API. Data is LRC-format, not clean prose."}, {"id": "claude_songs_kv", "label": "SONGS KV Namespace", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Tech Stack", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_cloudflare_workers_hono", "label": "Cloudflare Workers + Hono Backend", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Tech Stack", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps the target lyrics secret server-side; never exposes full lyrics to the client."}, {"id": "claude_vite_react_frontend", "label": "Vite + React Frontend", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Tech Stack", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_rooms_durable_object", "label": "Rooms (Salons) Durable Object", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Tech Stack; Domain-Specific Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One SQLite-backed Durable Object per room code, hibernatable WebSockets, deleted at next UTC midnight; the room's round lives in the object, never on a client."}, {"id": "claude_room_code_anti_enumeration", "label": "Room Code Anti-Enumeration", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Domain-Specific Rules: Rooms", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every join is rate-limited and no route answers differently for a live vs dead code."}, {"id": "claude_looking_alone", "label": "Looking Alone (solo round signed by the room)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Domain-Specific Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the member who completed the title sees victory at once; others keep searching on a solo round until they win or press Afficher la reponse."}, {"id": "claude_group_snapshot", "label": "GroupSnapshot Merge", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Domain-Specific Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Once out of every room, snapshots join the solo round via /api/round/resume so nothing found alone or together is lost."}, {"id": "claude_pwa_service_worker", "label": "PWA Hand-Written Service Worker", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Tech Stack; Domain-Specific Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No vite-plugin-pwa/Workbox; never answers the API or invite links; network-first navigation so deploys reach players at next visit."}, {"id": "claude_anti_cheat", "label": "Anti-Cheat Requirement", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Domain-Specific Rules; Anti-cheat shape", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Worker is the only code that sees unmasked lyrics; responses carry masked tokens only, and RoundView carries no song id because catalog ids are title slugs."}, {"id": "claude_sealed_round_state", "label": "AES-GCM Sealed Round State", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Anti-cheat shape", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps the Worker stateless while making forged progress impossible; sealed rather than signed so the song id never leaks."}, {"id": "claude_state_secret", "label": "STATE_SECRET", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Configuration", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only secret; from worker/.dev.vars locally (auto-created) or wrangler secret put; not in wrangler.toml since var and secret cannot share a name."}, {"id": "claude_dev_reveal_lyrics", "label": "DEV_REVEAL_LYRICS (devHint)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Domain-Specific Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_show_all_lyrics_revealhint", "label": "Show All Lyrics Checkbox (revealHint)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Domain-Specific Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuses the devHint mechanism gated on server-computed victory instead of a dev flag; no extra endpoint."}, {"id": "claude_dev_standin_song", "label": "DEV_STANDIN_SONG", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Domain-Specific Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Made-up song for dev/e2e only; production never plays a stand-in."}, {"id": "claude_dependency_outage_rule", "label": "Outage Is Never a Refusal Rule", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Domain-Specific Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LRCLIB not answering throws LrclibUnavailableError -> 503 Retry-After; only an answer with nothing usable moves the day's pick to the next catalog entry."}, {"id": "claude_clean_lyrics", "label": "cleanLyrics / MIN_LYRIC_WORDS", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Domain-Specific Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_monthly_catalog", "label": "Monthly Song Catalog", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Domain-Specific Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One list per UTC month, always a month ahead; a song is played once ever; played months and ids never edited; nothing before FIRST_SONG_DAY."}, {"id": "claude_archives", "label": "Archives (last 30 days)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Domain-Specific Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same round keyed by day; archives screen asks the server nothing; past days saved as sealed state not view to spare localStorage."}, {"id": "claude_hints", "label": "Song Hints (Epoque, Type d'artiste, Style)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Domain-Specific Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unlock at 20/35/50 guesses (HINT_THRESHOLDS), player picks; text curated in songFacts.ts, never sharing a word with title or artist."}, {"id": "claude_live_win_celebration", "label": "Live Win Celebration (confetti)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Domain-Specific Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only when the player's own guess completes the title; never for restored rounds or teammates' wins; none under reduced motion."}, {"id": "claude_french_text_matching", "label": "French Text Matching (normalize, elisions)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Domain-Specific Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_theming", "label": "Light/Dark Theming Tokens", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Domain-Specific Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_invite_links", "label": "Invite Links (/salon/<code>)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Domain-Specific Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Link preview identical for every code; never looks the room up or shows its host's pseudo."}, {"id": "claude_guess_delta", "label": "GuessDelta (reveal-only delta)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Performance", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A guess is answered with what it changed; a delta only ever reveals; old clients still get full views."}, {"id": "claude_performance_rule", "label": "Per-Guess Path Must Not Scale With Song Length", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Performance", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything slow was correct work repeated for an unchanged value; memoize per isolate, pin with work-counting tests, never timings."}, {"id": "claude_testing_philosophy", "label": "Testing Philosophy (script every check)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Testing Philosophy", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_continuous_improvement_loop", "label": "Continuous Improvement Loop (LEARNINGS.md)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Continuous Improvement Loop", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_commit_convention", "label": "Conventional Commits + Gitmoji", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Git Workflow", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_graphify_workflow", "label": "graphify Knowledge Graph Workflow", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "graphify", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the semantic cache is committed; the graph is rebuilt with npm run graph:update because committing it made huge diffs."}, {"id": "claude_gitignored_config_rule", "label": "Gitignored Config Is Never a Manual Step", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "C