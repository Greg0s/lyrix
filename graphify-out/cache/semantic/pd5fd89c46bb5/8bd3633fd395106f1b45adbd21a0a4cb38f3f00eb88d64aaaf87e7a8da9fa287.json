{"nodes": [{"id": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_delta_guess_responses_design", "label": "Delta Guess Responses Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every guess rebuilt and shipped the full masked round (~34 KB, ~800 objects), breaking the rule that nothing in the per-guess path scales with song length, and re-rendering ~800 WordTokens per guess."}, {"id": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_guessdelta", "label": "GuessDelta", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": "## 1. Wire contract", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_revealedslot", "label": "RevealedSlot", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": "## 1. Wire contract", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_guessanswer", "label": "GuessAnswer (GuessResult | GuessDelta)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": "## 1. Wire contract", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_roomrounddelta", "label": "RoomRoundDelta", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": "## 1. Wire contract", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_roomguessdelta", "label": "RoomGuessDelta", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": "## 1. Wire contract", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_buildguessdelta", "label": "buildGuessDelta", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": "## 2. Worker, alone", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds reveal only when the guess is found, from positions and wordTexts, so no hidden word's text is read before its guess is checked; revealed is O(found keys), not O(song)."}, {"id": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_wordtexts", "label": "analyzeSong wordTexts", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": "## 2. Worker, alone", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_applyreveal", "label": "applyReveal", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": "## 4. Client", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Copies only the title array, section, line and token each revealed position touches so untouched lines keep their identity and skip re-rendering; position index built once per song in a WeakMap."}, {"id": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_client_opt_in_compatibility", "label": "Client Opt-in Delta Compatibility", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": "## Decisions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clients ask with delta: true or ?delta=1; requests that don't ask get the full form for ever, and the new client accepts a full answer to cover the window where Pages deploys before the Worker."}, {"id": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_monotonic_idempotent_deltas", "label": "Monotonic Idempotent Deltas", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": "## Decisions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A delta only reveals words and adds guesses, so applying it twice or out of order converges without versions; anything that removes or replaces (win, day change, reconnection) is a full view."}, {"id": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_revealed_checksum", "label": "revealed Count Checksum", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": "## Decisions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every delta carries the round's revealed-word count; a client whose count disagrees resyncs via resumeRound (solo) or by reopening the socket (room)."}, {"id": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_word_position_addressing", "label": "Word Position Addressing", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": "## Decisions", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_room_guess_seq", "label": "RoomGuess seq Numbering", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": "## 3. Rooms", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A seq gap tells the client it missed a broadcast and must reconnect through admit."}, {"id": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_write_only_what_changed", "label": "Write Round View Only When Changed", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": "## 5. Local storage", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A miss rewrites only the day entry and archive summary; lyrix:view is rewritten only when viewChanged, OR-ed across coalesced writes."}, {"id": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_tokenrun_memo", "label": "Memoized TokenRun Line Rendering", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": "## 4. Client", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_incremental_placenearguesses", "label": "Incremental placeNearGuesses", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": "## 4. Client", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_delta_anti_cheat", "label": "Delta Anti-cheat Table", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": "## 6. Anti-cheat", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No new form reveals more than the full view would, and none names the song; covered by titleLeak.ts."}, {"id": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_work_counting_tests", "label": "Work-counting Performance Tests", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": "## 7. Tests", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bytes per miss, buildRoundView calls, broadcast size, WordToken renders and localStorage writes are pinned by counts, never timings."}], "edges": [{"source": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_delta_guess_responses_design", "target": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_guessdelta", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_delta_guess_responses_design", "target": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_roomrounddelta", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_delta_guess_responses_design", "target": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_buildguessdelta", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_delta_guess_responses_design", "target": "docs_superpowers_specs_2026_10_07_delta_guess_responses_design_applyreveal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-07-delta-guess-responses-design.md", "so